@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam dpi 180
left to right direction

interface InterestStrategy {
  +calculate(p, r, m): BigDecimal
}
class SavingsInterestStrategy
class LoanInterestStrategy
class InterestCalculator {
  -strategy: InterestStrategy
  +setStrategy(strategy)
  +calculate(p, r, m): BigDecimal
}
InterestStrategy <|.. SavingsInterestStrategy
InterestStrategy <|.. LoanInterestStrategy
InterestCalculator o-- InterestStrategy

@enduml
