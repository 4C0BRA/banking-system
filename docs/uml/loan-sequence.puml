@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam dpi 180
actor User
participant BankingFacade as Facade
participant LoanAgreementBuilder as Builder
participant InterestCalculator as Calculator
participant LoanInterestStrategy as Strategy
participant LoanAgreement as Agreement
User -> Facade: createLoan(terms)
Facade -> Builder: set borrower and terms
Facade -> Builder: build()
Builder -> Builder: validate fields
Builder -> Calculator: calculate(p, r, m)
Calculator -> Strategy: calculate(p, r, m)
Strategy --> Calculator: interest
Calculator --> Builder: rounded interest
Builder -> Agreement: construct
Builder --> Facade: agreement
Facade -> Facade: store agreement
Facade --> User: display document
@enduml
