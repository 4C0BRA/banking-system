@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam dpi 180
actor User
participant BankingFacade as Facade
participant Account
participant TransactionPublisher as Publisher
participant TransactionHistory as History
participant FraudMonitor as Monitor
User -> Facade: withdraw(id, 6000)
Facade -> Account: withdraw(6000)
Account --> Facade: balance updated
Facade -> Publisher: publish(transaction)
Publisher -> History: update(transaction)
Publisher -> Monitor: update(transaction)
Monitor -> Monitor: amount > 5000
Monitor -> Monitor: record alert
note right of Monitor
Calls Notifier.send
See delivery sequence
end note
Facade --> User: operation complete
@enduml
